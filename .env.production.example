# Copy to .env.production, fill in every value, and keep it out of git.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Public domain (DNS A/AAAA record must point at this server; ports 80 and 443 open).
SITE_DOMAIN=book.example-venue.ph
# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=ops@example-venue.ph

# Venue served by this deployment (create it with: docker compose ... exec api node dist/scripts/create-tenant.js ...)
TENANT_SLUG=demo-arena

# Database (internal network only, never published).
POSTGRES_USER=bookcourt
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=bookcourt

# Auth. The API refuses to start with a placeholder value.
JWT_SECRET=                 # openssl rand -base64 48
JWT_EXPIRES_IN=12h

LOG_LEVEL=info

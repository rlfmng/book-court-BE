# --- Server ---
NODE_ENV=development
# local | staging | production (production = strict startup checks, Swagger off)
APP_ENV=local
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Reverse proxies in front of the API (0 = none; 1 behind Caddy/nginx)
TRUST_PROXY=0

# --- Datastores ---
# Host-side URLs (pnpm dev / migrate / seed / test). docker-compose overrides these for the api container.
DATABASE_URL=postgres://bookcourt:bookcourt@localhost:5432/bookcourt
REDIS_URL=redis://localhost:6379
# Neon: paste the connection string from the Neon console (it ends in ?sslmode=require).
# Optional direct (non-pooled) URL for migrations when DATABASE_URL uses Neon's "-pooler" host.
MIGRATION_DATABASE_URL=
# disable | require | verify. Leave empty to follow the URL's sslmode (Neon/Supabase URLs include it).
DATABASE_SSL=
# CA for DATABASE_SSL=verify (PEM text or file path). Not needed for Neon, which uses a public CA.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
# 0 disables it (needed with transaction-mode poolers such as Neon's "-pooler" host)
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Auth ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=12h

# --- HTTP ---
# Comma-separated list of allowed browser origins (the Next.js app)
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# --- Booking engine ---
AVAILABILITY_CACHE_TTL_SECONDS=30
BOOKING_LOCK_TTL_MS=5000

# --- Rate limiting (public routes) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# --- Seed (pnpm seed) ---
SEED_OWNER_EMAIL=owner@demo-arena.ph
SEED_OWNER_PASSWORD=demo-owner-123

# --- docker-compose only ---
POSTGRES_USER=bookcourt
POSTGRES_PASSWORD=bookcourt
POSTGRES_DB=bookcourt
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000
# Venue slug baked into the web image at build time.
NEXT_PUBLIC_TENANT_SLUG=demo-arena
